# ============================================================================
# Project Autonomous Alpha — Live Trading Environment Template
# ============================================================================
#
# INSTRUCTIONS:
#   1. Copy this file to .env   (NEVER commit .env to version control)
#   2. Replace every <PLACEHOLDER> with your actual value
#   3. Read DOCS/PRODUCTION_ENV_REQUIREMENTS.md for full variable reference
#   4. Read DOCS/VALR_ONBOARDING_CHECKLIST.md for credential setup
#
# This template contains ONLY the variables needed for LIVE_EXECUTION mode.
# Placeholders ensure the system cannot start if you forget to fill one in.
#
# MODE PROGRESSION:
#   Step A: Fill in Section 1-3, set EXECUTION_MODE=DEMO        → paper test
#   Step B: Fill in Section 4,   set EXECUTION_MODE=LIVE_READ_ONLY → read-only
#   Step C: Fill in Section 5,   set EXECUTION_MODE=LIVE         → live trade
#
# WARNING: DO NOT set EXECUTION_MODE=LIVE until you have:
#   - Completed DOCS/VALR_ONBOARDING_CHECKLIST.md
#   - Deposited funds per DOCS/FUNDING_RUNBOOK.md
#   - Walked through DOCS/FIRST_LIVE_TRADE_CHECKLIST.md
# ============================================================================

# ============================================================================
# SECTION 1: DATABASE (Required — all modes)
# ============================================================================

# PostgreSQL superuser password (used by docker-compose for DB container)
# Generate: python -c "import secrets; print(secrets.token_hex(16))"
POSTGRES_PASSWORD=<GENERATE_UNIQUE_SECRET>

# Application database user password
# Generate: python -c "import secrets; print(secrets.token_hex(16))"
DB_PASSWORD=<GENERATE_UNIQUE_SECRET>

DB_HOST=db
DB_PORT=5432
DB_NAME=autonomous_alpha
DB_USER=app_trading
DB_ECHO=false

# ============================================================================
# SECTION 2: AUTHENTICATION (Required — all modes)
# ============================================================================

# Webhook HMAC-SHA256 verification key (minimum 32 characters)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SOVEREIGN_SECRET=<GENERATE_64_CHAR_HEX>

# Guardian manual unlock token
# Generate: python -c "import secrets; print(secrets.token_hex(16))"
GUARDIAN_ADMIN_TOKEN=<GENERATE_UNIQUE_SECRET>

# Guardian hard-stop reset code
# Generate: python -c "import secrets; print(secrets.token_hex(16))"
GUARDIAN_RESET_CODE=<GENERATE_UNIQUE_SECRET>

# ============================================================================
# SECTION 3: OPERATOR IDENTITY (Required — all modes)
# ============================================================================

# At least one operator ID who can approve trades via HITL
# Example: operator_alpha  (or your chosen ID)
HITL_ALLOWED_OPERATORS=<YOUR_OPERATOR_ID>

HITL_ENABLED=true
HITL_TIMEOUT_SECONDS=300

# ============================================================================
# SECTION 4: VALR CREDENTIALS (Required — LIVE_READ_ONLY & LIVE_EXECUTION)
# ============================================================================
# Follow DOCS/VALR_ONBOARDING_CHECKLIST.md to generate these.
# Permissions required: View + Trade (NOT Withdraw)

VALR_API_KEY=<YOUR_VALR_API_KEY>
VALR_API_SECRET=<YOUR_VALR_API_SECRET>

# ============================================================================
# SECTION 5: EXECUTION MODE (Start with DEMO, progress to LIVE)
# ============================================================================

# Start here — paper trading (no exchange interaction)
EXECUTION_MODE=DEMO
DEMO_MODE=PAPER

# --- STEP B: Uncomment for read-only exchange access ---
# EXECUTION_MODE=LIVE_READ_ONLY
# LIVE_READ_ONLY=TRUE

# --- STEP C: Uncomment for live trading (ONLY after full checklist) ---
# EXECUTION_MODE=LIVE
# LIVE_TRADING_CONFIRMED=TRUE

# ============================================================================
# SECTION 6: RISK CONTROLS (Required — LIVE_EXECUTION)
# ============================================================================

# Maximum single order value in ZAR (start conservative)
MAX_ORDER_ZAR=500

# Guardian equity floor — set to your ACTUAL funded amount
# Guardian enforces 1% daily loss limit against this number
ZAR_FLOOR=<YOUR_FUNDED_EQUITY_ZAR>

# Maximum risk per trade in ZAR
MAX_RISK_ZAR=500

# ============================================================================
# SECTION 7: OPTIONAL — Discord Notifications
# ============================================================================

# Discord webhook for trade alerts (recommended but optional)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<ID>/<TOKEN>
# DISCORD_ALERT_LEVEL=WARNING

# ============================================================================
# SECTION 8: OPTIONAL — AI Council
# ============================================================================

# OpenRouter API key for AI consensus (recommended)
# Sign up: https://openrouter.ai/
# OPENROUTER_API_KEY=<YOUR_OPENROUTER_KEY>

# ============================================================================
# SECTION 9: INFRASTRUCTURE — Docker defaults (usually no change needed)
# ============================================================================

PYTHONUNBUFFERED=1
DEMO_STATE_FILE=data/demo_broker_state.json
GUARDIAN_LOCK_FILE=data/guardian_lock.json
GUARDIAN_AUDIT_DIR=data/guardian_audit
STRATEGY_MODE=DETERMINISTIC
KILL_SWITCH_ENABLED=true
CORS_ORIGINS=http://localhost:3000
