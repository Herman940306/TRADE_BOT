# Dockerfile.local - FastAPI HTTP Server for Local Development
# BOOT-005 fix: runs uvicorn so /health /webhook /api/hitl endpoints are reachable
# Used by docker-compose.local.yml app service only
FROM python:3.11-slim-bookworm
LABEL version=1.9.0-local
RUN apt-get update && apt-get install -y --no-install-recommends libpq-dev gcc curl procps && rm -rf /var/lib/apt/lists/* && apt-get clean
RUN useradd --create-home --shell /bin/bash sovereign
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir -r requirements.txt
COPY app/ ./app/
COPY database/ ./database/
COPY scripts/ ./scripts/
COPY services/ ./services/
COPY data_ingestion/ ./data_ingestion/
COPY jobs/ ./jobs/
COPY tools/ ./tools/
COPY main.py ./main.py
RUN mkdir -p /app/logs /app/data && chown -R sovereign:sovereign /app
USER sovereign
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=10s --start-period=30s --retries=5 CMD curl -f http://localhost:8080/health || exit 1
# Shell form avoids JSON array quote escaping issues in this build environment
CMD uvicorn app.main:app --host 0.0.0.0 --port 8080 --workers 1 --log-level info
